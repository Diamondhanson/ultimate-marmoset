# ── Supabase ─────────────────────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard, then find these under
# Project Settings → API keys. See SETUP.md for the full walkthrough.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Project Settings → API keys → service_role / secret).
# Server-only, never exposed to the browser. Used by the dashboard for writes
# and photo uploads, and for saving reservations + contact messages.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (reservation + contact emails) ────────────────────────────────
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address for notification emails. Must be on a domain verified at
# https://resend.com/domains (before verifying, use the sandbox sender
# "Ultimate Marmoset <onboarding@resend.dev>" — it delivers only to your own
# account inbox).
RESEND_FROM_EMAIL=Ultimate Marmoset <hello@ultimatemarmoset.com>

# ── Admin ────────────────────────────────────────────────────────────────
# Where reservation + contact notifications are sent.
NOTIFICATION_EMAIL=hello@ultimatemarmoset.com

# The only email allowed to log in to the dashboard. Must match a Supabase auth
# user. Falls back to receiving notifications if NOTIFICATION_EMAIL is unset.
ADMIN_EMAIL=hello@ultimatemarmoset.com

# Password for the PREVIEW-ONLY dashboard login. This login only works while
# Supabase is not configured. Once the Supabase keys above are filled in, the
# dashboard switches to real Supabase email/password auth and this is ignored.
ADMIN_PREVIEW_PASSWORD=preview

# ── Analytics / Google Ads (optional; tracking is off until these are set) ──
# GA4 Measurement ID from analytics.google.com (Admin → Data streams), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Ads tag ID from ads.google.com (Tools → Google tag), e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion labels (Google Ads → Goals → Conversions → your conversion →
# "Tag setup"), the part after the slash in AW-XXXX/label
NEXT_PUBLIC_GOOGLE_ADS_RESERVATION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=

# ── Google Search Console (optional) ─────────────────────────────────────
# Only needed if you verify with the "HTML tag" method. Paste just the
# content value from the tag, e.g. abc123XYZ. Leave blank if you verified
# with a DNS record instead.
GOOGLE_SITE_VERIFICATION=
